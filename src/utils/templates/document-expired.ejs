<!DOCTYPE html>
<html>
<body style="font-family:Arial,Helvetica,sans-serif;background:#f4f4f7;padding:40px;">

<div style="max-width:600px;margin:auto;background:#fff;padding:40px;border-radius:8px;">

<h2 style="color:#dc2626;">
<%= documentType %> Expired
</h2>

<p>Hello,</p>

<p>
<% if (documentType === "Emirates ID") { %>
Your Account has been temporarily locked due to the expiration of your <strong><%= documentType %></strong> on <strong><%= expiryDate %></strong>.
</p>
<% } else { %>
Your <strong><%= documentType %></strong> has expired on <strong><%= expiryDate %></strong>.
</p>
<% } %>

<p>
Please upload a valid <%= documentType.toLowerCase() %> as soon as possible
to activate your account.
</p>

<p>Thank you,<br><%= appName %></p>

</div>

</body>
</html>
