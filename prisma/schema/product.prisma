enum ActorType {
  CUSTOMER
  ADMIN
  SYSTEM
  COURIER
  GATEWAY
}

enum ProductBadge {
  NEW
  SALE
  BEST_SELLER
  LIMITED
  COMBO
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StockMovementType {
  RESERVE
  RELEASE
  DEDUCT
  RETURN_RESTOCK
  EXCHANGE_RESERVE
  EXCHANGE_RELEASE
  ADJUSTMENT
  RESTOCK
  DAMAGED
  STOCKTAKE
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum StocktakeStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StorageProvider {
  LOCAL
  BUNNY
}

model Category {
  id             String          @id @default(uuid())
  parentId       String?
  name           String
  slug           String          @unique
  description    String?
  imageKey       String?
  imageProvider  StorageProvider?
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, sortOrder])
  @@index([isActive])
  @@map("categories")
}

model ProductColor {
  id        String @id @default(uuid())
  productId String
  name      String
  hex       String? // swatch only (data, not a UI theme color)
  sortOrder Int    @default(0)

  product  Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants Variant[]
  images   ProductImage[]

  @@unique([productId, name])
  @@index([productId, sortOrder])
  @@map("product_colors")
}

model Product {
  id                 String          @id @default(uuid())
  name               String
  slug               String          @unique
  code               String?         @unique // internal style code
  description        String?
  material           String?
  fit                String? // slim / regular / relaxed (validated list in Zod)
  careInstructions   String?
  categoryId         String
  status             ProductStatus   @default(DRAFT)
  regularPrice       Int // poisha
  badges             ProductBadge[]
  isExchangeEligible Boolean         @default(true) // false = final sale
  seoTitle           String?
  seoDescription     String?
  publishedAt        DateTime?
  archivedAt         DateTime?
  createdById        String?
  updatedById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  version            Int             @default(1)

  category  Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  colors    ProductColor[]
  variants  Variant[]
  images    ProductImage[]
  offers    ProductOffer[]
  createdBy User?          @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?          @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([categoryId, status])
  @@index([status, publishedAt])
  @@index([name])
  @@index([regularPrice])
  @@map("products")
}

model ProductImage {
  id         String          @id @default(uuid())
  productId  String
  colorId    String?
  storageKey String          @unique
  provider   StorageProvider
  alt        String?
  sortOrder  Int             @default(0)
  isPrimary  Boolean         @default(false)
  width      Int?
  height     Int?
  sizeBytes  Int?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   ProductColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([colorId])
  @@map("product_images")
}

model Variant {
  id                String   @id @default(uuid())
  productId         String
  colorId           String
  size              String
  sizeOrder         Int      @default(0)
  sku               String   @unique
  onHand            Int      @default(0)
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(3)
  isActive          Boolean  @default(true)
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  color   ProductColor @relation(fields: [colorId], references: [id], onDelete: Restrict)

  movements      StockMovement[]
  notifyRequests StockNotifyRequest[]

  @@unique([productId, colorId, size])
  @@index([productId, isActive])
  @@index([onHand, reserved])
  @@map("variants")
}

model StockNotifyRequest {
  id         String    @id @default(uuid())
  variantId  String
  customerId String?
  phone      String?
  email      String?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  variant  Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([variantId, notifiedAt])
  @@map("stock_notify_requests")
}

model StockMovement {
  id            BigInt            @id @default(autoincrement())
  variantId     String
  type          StockMovementType
  onHandDelta   Int               @default(0)
  reservedDelta Int               @default(0)
  onHandAfter   Int
  reservedAfter Int
  refType       String? // ORDER, EXCHANGE, STOCKTAKE, MANUAL
  refId         String?
  note          String?
  actorType     ActorType         @default(SYSTEM)
  actorId       String?
  createdAt     DateTime          @default(now())

  variant Variant @relation(fields: [variantId], references: [id])

  @@index([variantId, createdAt])
  @@index([refType, refId])
  @@map("stock_movements")
}

model ProductOffer {
  id         String    @id @default(uuid())
  productId  String
  offerPrice Int
  startsAt   DateTime  @default(now())
  endsAt     DateTime?
  isActive   Boolean   @default(true)
  createdById String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ProductOfferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId, isActive, startsAt, endsAt])
  @@map("product_offers")
}
