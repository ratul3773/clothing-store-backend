NODE_ENV=development
PORT=5000
DATABASE_URL="your_database_url_here"

BETTER_AUTH_SECRET="your_secret_key_here"
FRONTEND_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:5000"

SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
SMTP_FROM="Clothing Store <no-reply@example.com>"

# Product image storage. Development defaults to local disk; production requires Bunny.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_BASE_URL="http://localhost:5000/uploads"
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_PRODUCT=8

# Required when STORAGE_DRIVER=bunny (also required automatically in production).
BUNNY_CDN_ACCESS_KEY=""
BUNNY_CDN_STORAGE_ZONE=""
BUNNY_CDN_PULL_URL=""
BUNNY_STORAGE_ENDPOINT="https://storage.bunnycdn.com"

# Used only by `npm run admin:seed`.
ADMIN_NAME="Store Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-at-least-12-characters"
ADMIN_PHONE="01712345678"
